<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Version.props" />
	<PropertyGroup>
		<LangVersion>10.0</LangVersion>
		<TargetFrameworks>netstandard2.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DriverName>AcmeDriver</DriverName>
		<!-- Single-place versioning: Version.props. The pipeline overrides Version to add a -preview suffix. -->
		<VersionPrefix>$(IviMajorVersion).$(IviMinorVersion).$(IviPatchVersion)</VersionPrefix>
		<Company>Acme Technologies</Company>
		<Description>IVI.NET Driver</Description>
		<PackageTags>IVI;IVI-Driver-NET-Conformant; IVI-Driver;IVI-Foundation</PackageTags>
		<BaseOutputPath>..\build</BaseOutputPath>
		<AssemblyName>Acme.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>Acme.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<!-- Always the newest IviFoundation.DriverCore in the local feed (see nuget.config), preview or release. -->
		<PackageReference Include="IviFoundation.DriverCore" Version="*-*"/>
	</ItemGroup>
</Project>
