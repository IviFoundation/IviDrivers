<?xml version="1.0" encoding="UTF-8"?>

<?if $(var.Platform) = "x64" ?>
  <?define x64 = "64" ?>
  <?define x32 = "" ?>
  <?define Win64 = "yes" ?>
<?else?>
  <?define x64 = "" ?>
  <?define x32 = "32" ?>
  <?define Win64 = "no" ?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product
      Id="*"
      Name="$(var.ProductName)"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="$(var.Manufacturer)"
      UpgradeCode="$(var.UpgradeCode)">

    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Platform="$(var.Platform)" />

    <MediaTemplate />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles$(var.x64)Folder">
        <Directory Id="IviFoundationDir" Name="IVI Foundation">
          <Directory Id="IVIDir" Name="IVI">
            <Directory Id="IVINETDir" Name="Microsoft.NET">
              <Directory Id="FrameworkDir" Name="Framework$(var.x32)$(var.x64)">
                <Directory Id="Fx40Dir" Name="v4.6">
                  <Directory Id="ProductDir" Name="IviDriverCoreSharedComponent $(var.ProductVersion)">

                    <Component Id="cmpDriverCore"
                               Guid="2a6700d8-7d1a-4b1d-8ec2-1fa3e16e7d75"
                               Win64="$(var.Win64)">

                      <File Id="IviDriverCoreDll"
                            Source="$(var.BuildOutput)\Ivi.DriverCore.dll"
                            KeyPath="yes" />

                      <File Id="IviDriverCoreXml"
                            Source="$(var.BuildOutput)\Ivi.DriverCore.xml"
                            CompanionFile="IviDriverCoreDll" />

                    </Component>

                    <?ifdef PolicyAssemblyName?>
                    <Component Id="cmpPolicy"
                               Guid="5e0c3f6a-8b1d-4c52-9a77-3d1f2b6e4a90"
                               Win64="$(var.Win64)">

                      <File Id="PolicyDll"
                            Source="$(var.PolicyDir)$(var.PolicyAssemblyName).dll"
                            KeyPath="yes" />

                      <File Id="PolicyConfig"
                            Source="$(var.PolicyDir)$(var.PolicyAssemblyName).config" />

                    </Component>
                    <?endif?>

                  </Directory>
                </Directory>
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature"
             Title="$(var.ProductName)"
             Level="1">
      <ComponentRef Id="cmpDriverCore"/>
      <?ifdef PolicyAssemblyName?>
      <ComponentRef Id="cmpPolicy"/>
      <?endif?>
    </Feature>


    <!-- GAC Install: runs after files are copied -->
    <CustomAction Id="GacInstallCmd"
                  Property="GacInstall"
                  Value="&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Add-Type -AssemblyName 'System.EnterpriseServices'; (New-Object System.EnterpriseServices.Internal.Publish).GacInstall('[#IviDriverCoreDll]')&quot;" />
    <CustomAction Id="GacInstall"
                  BinaryKey="WixCA"
                  DllEntry="CAQuietExec$(var.x64)"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <!-- GAC Uninstall: runs before files are removed -->
    <CustomAction Id="GacUninstallCmd"
                  Property="GacUninstall"
                  Value="&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Add-Type -AssemblyName 'System.EnterpriseServices'; (New-Object System.EnterpriseServices.Internal.Publish).GacRemove('[#IviDriverCoreDll]')&quot;" />
    <CustomAction Id="GacUninstall"
                  BinaryKey="WixCA"
                  DllEntry="CAQuietExec$(var.x64)"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <!-- Publisher policy (policy.major.minor.Ivi.DriverCore): only present when Msi.wixproj built it (strong-name
         key supplied). It has its own install and remove actions, because adding it to the commands above would
         push their text over the 255 character limit of the CustomAction Target column (ICE03). -->
    <?ifdef PolicyAssemblyName?>
    <CustomAction Id="GacInstallPolicyCmd"
                  Property="GacInstallPolicy"
                  Value="&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Add-Type -AssemblyName 'System.EnterpriseServices'; (New-Object System.EnterpriseServices.Internal.Publish).GacInstall('[#PolicyDll]')&quot;" />
    <CustomAction Id="GacInstallPolicy"
                  BinaryKey="WixCA"
                  DllEntry="CAQuietExec$(var.x64)"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <CustomAction Id="GacUninstallPolicyCmd"
                  Property="GacUninstallPolicy"
                  Value="&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Add-Type -AssemblyName 'System.EnterpriseServices'; (New-Object System.EnterpriseServices.Internal.Publish).GacRemove('[#PolicyDll]')&quot;" />
    <CustomAction Id="GacUninstallPolicy"
                  BinaryKey="WixCA"
                  DllEntry="CAQuietExec$(var.x64)"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />
    <?endif?>

    <InstallExecuteSequence>
      <Custom Action="GacInstallCmd" Before="GacInstall">NOT REMOVE</Custom>
      <Custom Action="GacInstall" After="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="GacUninstallCmd" Before="GacUninstall">REMOVE="ALL"</Custom>
      <Custom Action="GacUninstall" Before="RemoveFiles">REMOVE="ALL"</Custom>
      <?ifdef PolicyAssemblyName?>
      <Custom Action="GacInstallPolicyCmd" Before="GacInstallPolicy">NOT REMOVE</Custom>
      <Custom Action="GacInstallPolicy" After="GacInstall">NOT REMOVE</Custom>
      <Custom Action="GacUninstallPolicyCmd" Before="GacUninstallPolicy">REMOVE="ALL"</Custom>
      <Custom Action="GacUninstallPolicy" Before="GacUninstall">REMOVE="ALL"</Custom>
      <?endif?>
    </InstallExecuteSequence>

  </Product>

</Wix>
