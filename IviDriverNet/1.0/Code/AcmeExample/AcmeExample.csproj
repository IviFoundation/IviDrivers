<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Version.props" />
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<LangVersion>10.0</LangVersion>
		<TargetFrameworks>net6.0;net462</TargetFrameworks>
		<RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DriverName>AcmeExample</DriverName>
		<!-- Single-place versioning: Version.props. The pipeline overrides Version to add a -preview suffix. -->
		<VersionPrefix>$(IviMajorVersion).$(IviMinorVersion).$(IviPatchVersion)</VersionPrefix>
		<Company>Acme Technologies</Company>
		<Description>IVI.NET Driver Example Project</Description>
		<BaseOutputPath>..\build</BaseOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<!-- Always the newest Acme.AcmeDriver in the local feed (see nuget.config), preview or release. -->
		<PackageReference Include="Acme.AcmeDriver" Version="*-*"/>
	</ItemGroup>
</Project>
